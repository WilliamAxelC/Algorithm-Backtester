[Unit]
Description=CUANG QUANT 10Y Real-Market Pre-Rendered Backtester Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/agent/orca/Algorithm-Backtester
Environment=NODE_ENV=production
Environment=PORT=4175
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/home/agent/orca/Algorithm-Backtester/data
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
Nice=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
